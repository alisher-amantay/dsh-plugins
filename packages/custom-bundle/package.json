{
  "name": "@alisheramantay/dsh-custom-bundle",
  "description": "Opinionated DeepSeek Harness profile layer for Alisher Amantay's plugin set",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/alisher-amantay/dsh-plugins.git", "directory": "packages/custom-bundle" },
  "type": "module",
  "exports": { "./cordis.patch.yml": "./cordis.patch.yml", "./presets/*.patch.yml": "./presets/*.patch.yml", "./package.json": "./package.json" },
  "files": ["cordis.patch.yml", "presets/standard.patch.yml", "presets/ptc.patch.yml", "presets/cordis.patch.yml", "presets/weak-strong-review.patch.yml", "README*.md"],
  "scripts": { "pack:check": "pnpm pack --dry-run" },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/ptc.patch.yml",
        "./presets/cordis.patch.yml",
        "./presets/weak-strong-review.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@alisheramantay/dsh-client-chat-extended": "workspace:^",
    "@alisheramantay/dsh-client-goal-extended": "workspace:^",
    "@alisheramantay/dsh-goal-round-driver-delayed": "workspace:^",
    "@alisher-amantay/dsh-observational-memory": "workspace:^",
    "@alisheramantay/dsh-tool-goal-extended": "workspace:^",
    "@alisheramantay/dsh-tool-pdf": "workspace:^"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.5-alpha.1", "@deepseek-ai/dsh-web-app": ">=0.2.1-alpha.2 <0.2.2" }
}

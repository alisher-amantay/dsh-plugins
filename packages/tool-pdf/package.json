  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-alpha.2 <0.2.2",
    "@deepseek-ai/dsh-fs": ">=0.2.1-alpha.2 <0.2.2",

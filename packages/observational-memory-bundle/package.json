{
  "name": "@alisher-amantay/dsh-observational-memory-bundle",
  "description": "DeepSeek Harness profile bundle that makes observational memory the default compaction engine",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alisher-amantay/dsh-plugins.git",
    "directory": "packages/observational-memory-bundle"
  },
  "type": "module",
  "exports": {
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["presets/standard.patch.yml", "presets/ptc.patch.yml", "presets/cordis.patch.yml", "README*.md"],
  "scripts": {
    "test": "vitest run --root ../.. packages/observational-memory-bundle/tests",
    "pack:check": "pnpm pack --dry-run"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": ["./presets/standard.patch.yml", "./presets/ptc.patch.yml", "./presets/cordis.patch.yml"]
    }
  },
  "dependencies": {
    "@alisher-amantay/dsh-observational-memory": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-web-app": ">=0.2.1-alpha.2 <0.2.2"
  }
}

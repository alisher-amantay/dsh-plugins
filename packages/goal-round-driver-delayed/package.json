{
  "name": "@alisheramantay/dsh-goal-round-driver-delayed",
  "description": "Race-fenced same-session goal-round driver with configurable cadence",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/alisher-amantay/dsh-plugins.git", "directory": "packages/goal-round-driver-delayed" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/*.js", "lib/types/**/*.d.ts", "README*.md"],
  "scripts": { "build": "tsc -b && tsdown", "test": "vitest run --root ../.. packages/goal-round-driver-delayed/tests", "pack:check": "pnpm pack --dry-run" },
  "license": "MIT",
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.2" },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-agent-loop-testkit": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-goal": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.5 <0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-goal": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.5 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.5 <0.2.0"
  }
